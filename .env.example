# nyarch desktop client environment
# Copy to .env.local before building. For CI desktop builds, set the same
# variables as GitHub Actions repository secrets.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Giphy (optional — falls back to public demo key).
# Get one at https://developers.giphy.com/dashboard/
VITE_GIPHY_API_KEY=
